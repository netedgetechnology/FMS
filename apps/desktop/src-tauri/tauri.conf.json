{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinanceOS",
  "version": "0.1.0",
  "identifier": "com.financeos.app",

  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "FinanceOS",
        "width": 1600,
        "height": 950,
        "minWidth": 1400,
        "minHeight": 850,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
